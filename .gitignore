# Real captures from a game install (SavedVariables, combat logs) never land in the tree:
# the capture script scrubs them into fixtures first.
captures/
*.local.*
.DS_Store
node_modules/
dist/
target/
.env
.env.*
# The core packages scripts/core-package.mjs builds by default.
dist-core/
# An addon kept in a repository of its own (the core, a mod): its folder is fetched from the release its pin.json
# names (scripts/fetch-addons.mjs), never committed here.
mods/wow/*/addon/
cores/wow/addon/Ryna_Core/
cores/wow/addon/.fetched
# The pinned mods' repositories, cloned by scripts/pinned-tests.sh.
.pinned/
