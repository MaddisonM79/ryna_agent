{
  "name": "ryna-wow-app",
  "private": true,
  "version": "0.5.5",
  "description": "Ryna, the World of Warcraft: Forever companion app (Tauri 2 over agent/host and the WoW core, cores/wow/core).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "scripts": {
    "dev": "node ../../scripts/fetch-addons.mjs && vite",
    "build": "node ../../scripts/fetch-addons.mjs && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "tauri": "node scripts/tauri.mjs",
    "icon": "tauri icon app-icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
